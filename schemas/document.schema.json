{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "width": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 2000
    },
    "height": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 2000
    },
    "unit": {
      "default": "mm",
      "type": "string",
      "enum": ["mm", "in", "pt"]
    },
    "ppi": {
      "default": 300,
      "type": "number",
      "minimum": 36,
      "maximum": 1200
    },
    "bleed": {
      "default": 0,
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "safe_margin": {
      "default": 0,
      "type": "number",
      "minimum": 0,
      "maximum": 100
    }
  },
  "required": ["width", "height", "unit", "ppi", "bleed", "safe_margin"],
  "additionalProperties": false
}
