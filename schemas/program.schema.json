        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema8"
          }
        }
      ]
    },
    "__schema9": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/__schema2"
      },
      "additionalProperties": {
        "$ref": "#/$defs/__schema2"
      }
    },
    "__schema10": {
      "default": 10000,
      "type": "integer",
      "minimum": 50,
      "maximum": 30000
    },
    "__schema11": {
      "type": "string"
    },
    "__schema12": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    }
  }
