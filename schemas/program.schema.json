    },
    "target": {
      "$ref": "#/$defs/__schema3"
    },
    "width": {
      "$ref": "#/$defs/__schema4"
    },
    "height": {
      "$ref": "#/$defs/__schema5"
    },
    "seed": {
      "$ref": "#/$defs/__schema6"
    },
    "parameters": {
      "$ref": "#/$defs/__schema7"
